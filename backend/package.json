{
  "name": "@autonomy/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FHIR bulk-data ingestion and prior-authorization review backend",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
